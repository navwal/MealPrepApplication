
@model MealPrepApplication.Models.Meal
<img src="@Url.Content("~/images/Meatballdog.png")" alt="Meatball dog" class="img-right"/>
<style>
	body {
		background-image: url('@Url.Content("~/images/Recipe_Background.jpg")');
		background-size: cover;
		background-repeat: no-repeat;
		background-position: center;
		background-attachment: fixed;
	}
</style>
<h1>@Model.Title</h1>

<div class="d-flex align-items-start gap-3">
	<div class="card" style="width: 18rem;">
		<div class="card-header text-white" style="background-color: black">Ingredients</div>
		@if (Model.Ingredients != null && Model.Ingredients.Any())
		{
			int alternate_row = 0;
			<ul class="list-group list-group-flush" id="ingredients">
				@foreach (var item in Model.Ingredients)
				{
					@if (alternate_row % 2 == 0 && item.item_amt > 0)
					{
						<li class="list-group-item text-white d-flex justify-content-between align-items-center" style="background-color: saddlebrown">
							<input class="form-check-input" type="checkbox" id="flexCheckbox" value="@item.item_id @item.item_amt @item.item_unit" />
							@item.item_id
							<span class="badge bg-secondary rounded-pill">@item.item_amt @item.item_unit</span>
						</li>
					}
					else if (item.item_amt > 0)
					{
						<li class="list-group-item list-group-item-secondary d-flex justify-content-between align-items-center">
							<input class="form-check-input" type="checkbox" id="flexCheckboxAlt" value="@item.item_id @item.item_amt @item.item_unit" />
							@item.item_id
							<span class="badge bg-secondary rounded-pill">@item.item_amt @item.item_unit</span>
						</li>
					}
					else if (!String.IsNullOrWhiteSpace(item.item_id))
					{
						<li class="list-group-item d-flex justify-content-between align-items-center text-white" style="background-color: black">
							@item.item_id
						</li>
					}
					alternate_row++;
				}
			</ul>
		}
		else
		{
			<p>No ingredients listed.</p>
		}
	</div>
	<div style="margin-left: 15%;">
		<body>
			<div style="white-space: pre-wrap; width: 500px; font-weight: bold; font-size: 150%;">
				@Model.Steps
			</div>
		</body>
	</div>
</div>
<button id="exportBtn" style="margin-top: 5%">Export unchecked to CSV</button>
<script>
    document.getElementById("exportBtn").addEventListener("click", function () {
        try {
            const list = document.querySelectorAll("#ingredients input[type='checkbox']");
            let uncheckedItems = [];

            list.forEach(cb => {
                if (!cb.checked) {
                    uncheckedItems.push(cb.value);
                }
            });

            if (uncheckedItems.length === 0) {
                alert("All items are checked. Nothing to export.");
                return;
            }

            // Create CSV content
            let csvContent = "data:text/csv;charset=utf-8," 
                           + uncheckedItems.map(item => `"${item}"`).join("\n");

            // Create a download link
            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", "Required_items.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        } catch (err) {
            console.error("Error exporting CSV:", err);
            alert("An error occurred while exporting.");
        }
    });
</script>